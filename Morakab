    <script>
        // راه‌اندازی آیکون‌های Lucide
        lucide.createIcons();

        // متغیرهای وضعیت برنامه
        let compoundingMode = 'monthly'; // 'monthly' یا 'yearly'
        let currentChartType = 'bar'; // 'bar' یا 'line'
        let growthChartInstance = null;

        // ارجاع به المان‌های DOM
        const initialInput = document.getElementById('initialInput');
        const initialSlider = document.getElementById('initialSlider');
        const monthlyInput = document.getElementById('monthlyInput');
        const monthlySlider = document.getElementById('monthlySlider');
        const rateInput = document.getElementById('rateInput');
        const rateSlider = document.getElementById('rateSlider');
        const yearsInput = document.getElementById('yearsInput');
        const yearsSlider = document.getElementById('yearsSlider');

        // فرمت کردن عدد با کامای سه‌رقمی انگلیسی (مثلاً 50,000,000) برای ورودی‌ها
        function formatWithCommas(num) {
            if (isNaN(num) || num === null) return '0';
            return Math.round(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        // تبدیل ارقام انگلیسی به فارسی همراه با کاما برای نمایش در کارت‌ها و جداول
        function formatPersianNumber(num) {
            if (isNaN(num) || num === null) return '۰';
            const formatted = formatWithCommas(Math.round(num));
            const persianDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
            return formatted.replace(/\d/g, x => persianDigits[x]);
        }

        // تبدیل اعداد فارسی یا دارای کاما به عدد خالص انگلیسی جهت محاسبه
        function parseCleanNumber(str) {
            if (typeof str === 'number') return str;
            if (!str) return 0;
            const persianDigits = [/۰/g, /۱/g, /۲/g, /۳/g, /۴/g, /۵/g, /۶/g, /۷/g, /۸/g, /۹/g];
            const arabicDigits = [/٠/g, /١/g, /٢/g, /٣/g, /٤/g, /٥/g, /٦/g, /٧/g, /٨/g, /٩/g];
            let clean = str.toString();
            for (let i = 0; i < 10; i++) {
                clean = clean.replace(persianDigits[i], i).replace(arabicDigits[i], i);
            }
            clean = clean.replace(/[^0-9.]/g, '');
            const parsed = parseFloat(clean);
            return isNaN(parsed) ? 0 : parsed;
        }

        // تبدیل عدد بزرگ به معادل متنی خوانا (میلیون / میلیارد / همت)
        function numberToFriendlyWords(num) {
            if (num >= 1e12) {
                return `حدود formatPersianFloat(num / 1e12) هزار میلیارد (همت)`.replace('formatPersianFloat(num / 1e12)', toPersianFloat(num / 1e12));
            } else if (num >= 1e9) {
                return `معادل ${toPersianFloat(num / 1e9)} میلیارد تومان`;
            } else if (num >= 1e6) {
                return `معادل ${toPersianFloat(num / 1e6)} میلیون تومان`;
            }
            return `${formatPersianNumber(num)} تومان`;
        }

        function toPersianFloat(num) {
            const fixed = num.toFixed(2).replace(/\.00$/, '');
            const persianDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
            return fixed.replace(/\d/g, x => persianDigits[x]).replace('.', '/');
        }

        // تابع اصلی محاسبه سود مرکب
        function calculateCompoundGrowth() {
            const initial = parseCleanNumber(initialInput.value);
            const monthly = parseCleanNumber(monthlyInput.value);
            const annualRate = parseFloat(rateInput.value) || 0;
            const years = parseInt(yearsInput.value) || 1;

            // بروزرسانی بج‌های راهنما
            document.getElementById('rateBadge').textContent = `${toPersianFloat(annualRate)}٪`;
            document.getElementById('monthsBadge').textContent = `${formatPersianNumber(years * 12)} ماه`;

            const labels = [];
            const principalData = [];
            const interestData = [];
            const totalData = [];
            const yearlyDetails = [];

            let currentBalance = initial;
            let totalPrincipal = initial;
            let previousTotalInterest = 0;

            const monthlyRate = (annualRate / 100) / 12;
            const yearlyRate = annualRate / 100;

            // سال صفر (شروع)
            labels.push('شروع');
            principalData.push(initial);
            interestData.push(0);
            totalData.push(initial);

            for (let y = 1; y <= years; y++) {
                if (compoundingMode === 'monthly') {
                    for (let m = 1; m <= 12; m++) {
                        // افزودن سود ماهانه و سپس واریز ماهانه
                        currentBalance = (currentBalance + monthly) * (1 + monthlyRate);
                        totalPrincipal += monthly;
                    }
                } else {
                    // ترکیب سالانه
                    const yearlyContribution = monthly * 12;
                    totalPrincipal += yearlyContribution;
                    currentBalance = (currentBalance + yearlyContribution) * (1 + yearlyRate);
                }

                const totalInterestSoFar = Math.max(0, currentBalance - totalPrincipal);
                const interestThisYear = totalInterestSoFar - previousTotalInterest;
                previousTotalInterest = totalInterestSoFar;

                labels.push(`سال ${formatPersianNumber(y)}`);
                principalData.push(Math.round(totalPrincipal));
                interestData.push(Math.round(totalInterestSoFar));
                totalData.push(Math.round(currentBalance));

                yearlyDetails.push({
                    year: y,
                    principal: totalPrincipal,
                    yearlyInterest: interestThisYear,
                    totalInterest: totalInterestSoFar,
                    balance: currentBalance
                });
            }

            const finalBalance = currentBalance;
            const finalInterest = Math.max(0, finalBalance - totalPrincipal);

            // بروزرسانی کارت‌های بالای صفحه
            document.getElementById('totalPrincipalCard').textContent = formatPersianNumber(totalPrincipal);
            document.getElementById('totalInterestCard').textContent = formatPersianNumber(finalInterest);
            document.getElementById('finalBalanceCard').textContent = formatPersianNumber(finalBalance);
            document.getElementById('finalBalanceWords').textContent = numberToFriendlyWords(finalBalance);

            // محاسبه درصدها و نوار پیشرفت
            const principalRatio = finalBalance > 0 ? Math.round((totalPrincipal / finalBalance) * 100) : 100;
            const interestRatio = 100 - principalRatio;

            document.getElementById('principalProgressBar').style.width = `${principalRatio}%`;
            document.getElementById('interestProgressBar').style.width = `${interestRatio}%`;

            const returnPercentage = totalPrincipal > 0 ? Math.round((finalInterest / totalPrincipal) * 100) : 0;
            document.getElementById('interestMultiplierBadge').textContent = `+${formatPersianNumber(returnPercentage)}٪ سود کل`;

            const growthFactor = totalPrincipal > 0 ? (finalBalance / totalPrincipal) : 1;
            document.getElementById('growthFactorText').textContent = `${toPersianFloat(growthFactor)} برابر آورده`;

            // تولید متن تحلیل هوشمند
            updateSmartInsight(years, totalPrincipal, finalInterest, finalBalance, interestRatio, yearlyDetails);

            // بروزرسانی نمودار و جدول
            updateChart(labels, principalData, interestData, totalData);
            updateYearlyTable(yearlyDetails);
        }

        function updateSmartInsight(years, principal, interest, total, interestRatio, yearlyDetails) {
            const insightEl = document.getElementById('smartInsightText');
            
            // پیدا کردن سالی که سود مرکب از اصل پول پیشی می‌گیرد
            const crossoverYear = yearlyDetails.find(item => item.totalInterest > item.principal);

            let message = `در پایان <strong class="text-white">${formatPersianNumber(years)} سال</strong>، از کل سرمایه نهایی شما، <strong class="text-amber-400">${formatPersianNumber(interestRatio)}٪</strong> آن صرفاً از محل سود مرکب ایجاد شده و تنها <strong class="text-slate-200">${formatPersianNumber(100 - interestRatio)}٪</strong> آورده نقدی مستقیم شماست. `;

            if (crossoverYear) {
                message += `نقطه عطف سرمایه‌گذاری شما در <strong class="text-emerald-400">سال ${formatPersianNumber(crossoverYear.year)}</strong> رخ می‌دهد؛ یعنی جایی که مجموع سود انباشته از کل پول واریزی شما بیشتر می‌شود!`;
            } else {
                message += `اگر افق زمانی یا نرخ بازدهی خود را کمی افزایش دهید، به نقطه عطف طلایی (پیشی گرفتن سود از کل آورده نقدی) خواهید رسید.`;
            }

            insightEl.innerHTML = message;
        }

        function updateYearlyTable(details) {
            const tbody = document.getElementById('yearlyTableBody');
            tbody.innerHTML = '';

            details.forEach(row => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/40 transition';
                tr.innerHTML = `
                    <td class="py-3 px-4 font-bold text-slate-200">سال ${formatPersianNumber(row.year)}</td>
                    <td class="py-3 px-4">${formatPersianNumber(row.principal)}</td>
                    <td class="py-3 px-4 text-amber-400/90">+${formatPersianNumber(row.yearlyInterest)}</td>
                    <td class="py-3 px-4 font-medium text-amber-400">${formatPersianNumber(row.totalInterest)}</td>
                    <td class="py-3 px-4 font-bold text-emerald-400">${formatPersianNumber(row.balance)}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateChart(labels, principalData, interestData, totalData) {
            const ctx = document.getElementById('growthChart').getContext('2d');

            // گرادینت‌های رنگی برای زیبایی نمودار
            const emeraldGrad = ctx.createLinearGradient(0, 0, 0, 350);
            emeraldGrad.addColorStop(0, 'rgba(16, 185, 129, 0.85)');
            emeraldGrad.addColorStop(1, 'rgba(16, 185, 129, 0.15)');

            const goldGrad = ctx.createLinearGradient(0, 0, 0, 350);
            goldGrad.addColorStop(0, 'rgba(245, 158, 11, 0.9)');
            goldGrad.addColorStop(1, 'rgba(245, 158, 11, 0.2)');

            if (growthChartInstance) {
                growthChartInstance.destroy();
            }

            const isBar = currentChartType === 'bar';

            growthChartInstance = new Chart(ctx, {
                type: isBar ? 'bar' : 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'مجموع آورده نقدی (اصل پول)',
                            data: principalData,
                            backgroundColor: isBar ? '#10B981' : emeraldGrad,
                            borderColor: '#10B981',
                            borderWidth: 2,
                            borderRadius: isBar ? 5 : 0,
                            fill: !isBar,
                            tension: 0.35,
                            stack: 'Stack 0'
                        },
                        {
                            label: 'سود مرکب انباشته',
                            data: interestData,
                            backgroundColor: isBar ? '#F59E0B' : goldGrad,
                            borderColor: '#F59E0B',
                            borderWidth: 2,
                            borderRadius: isBar ? 5 : 0,
                            fill: !isBar,
                            tension: 0.35,
                            stack: 'Stack 0'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: {
                                color: '#CBD5E1',
                                font: {
                                    family: 'Vazirmatn',
                                    size: 12
                                },
                                usePointStyle: true,
                                boxWidth: 8
                            }
                        },
                        tooltip: {
                            rtl: true,
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            titleColor: '#F8FAFC',
                            bodyColor: '#E2E8F0',
                            borderColor: '#334155',
                            borderWidth: 1,
                            padding: 12,
                            titleFont: { family: 'Vazirmatn', size: 13, weight: 'bold' },
                            bodyFont: { family: 'Vazirmatn', size: 12 },
                            footerFont: { family: 'Vazirmatn', size: 12, weight: 'bold' },
                            footerColor: '#34D399',
                            callbacks: {
                                label: function(context) {
                                    const val = context.parsed.y;
                                    return ` ${context.dataset.label}: ${formatPersianNumber(val)} تومان`;
                                },
                                footer: function(tooltipItems) {
                                    let sum = 0;
                                    tooltipItems.forEach(item => {
                                        sum += item.parsed.y;
                                    });
                                    return `ارزش کل: ${formatPersianNumber(sum)} تومان`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            grid: {
                                color: 'rgba(51, 65, 85, 0.2)'
                            },
                            ticks: {
                                color: '#94A3B8',
                                font: { family: 'Vazirmatn', size: 11 }
                            }
                        },
                        y: {
                            stacked: true,
                            grid: {
                                color: 'rgba(51, 65, 85, 0.25)'
                            },
                            ticks: {
                                color: '#94A3B8',
                                font: { family: 'Vazirmatn', size: 11 },
                                callback: function(value) {
                                    if (value >= 1e12) return toPersianFloat(value / 1e12) + ' همت';
                                    if (value >= 1e9) return toPersianFloat(value / 1e9) + ' میلیارد';
                                    if (value >= 1e6) return toPersianFloat(value / 1e6) + ' میلیون';
                                    return formatPersianNumber(value);
                                }
                            }
                        }
                    }
                }
            });
        }

        // همگام‌سازی اسلایدرها و ورودی‌های متنی
        function setupSyncListeners() {
            // سرمایه اولیه
            initialSlider.addEventListener('input', (e) => {
                initialInput.value = formatWithCommas(e.target.value);
                calculateCompoundGrowth();
            });
            initialInput.addEventListener('input', (e) => {
                const raw = parseCleanNumber(e.target.value);
                initialSlider.value = Math.min(raw, initialSlider.max);
                e.target.value = formatWithCommas(raw);
                calculateCompoundGrowth();
            });

            // واریز ماهانه
            monthlySlider.addEventListener('input', (e) => {
                monthlyInput.value = formatWithCommas(e.target.value);
                calculateCompoundGrowth();
            });
            monthlyInput.addEventListener('input', (e) => {
                const raw = parseCleanNumber(e.target.value);
                monthlySlider.value = Math.min(raw, monthlySlider.max);
                e.target.value = formatWithCommas(raw);
                calculateCompoundGrowth();
            });

            // درصد سود سالانه
            rateSlider.addEventListener('input', (e) => {
                rateInput.value = e.target.value;
                calculateCompoundGrowth();
            });
            rateInput.addEventListener('input', (e) => {
                let val = parseFloat(e.target.value) || 0;
                if (val > 200) val = 200;
                rateSlider.value = Math.min(val, rateSlider.max);
                calculateCompoundGrowth();
            });

            // مدت زمان (سال)
            yearsSlider.addEventListener('input', (e) => {
                yearsInput.value = e.target.value;
                calculateCompoundGrowth();
            });
            yearsInput.addEventListener('input', (e) => {
                let val = parseInt(e.target.value) || 1;
                if (val > 60) val = 60;
                yearsSlider.value = Math.min(val, yearsSlider.max);
                calculateCompoundGrowth();
            });
        }

        // تغییر نوع ترکیب سود (ماهانه یا سالانه)
        function setCompounding(mode) {
            compoundingMode = mode;
            const monthlyBtn = document.getElementById('compMonthlyBtn');
            const yearlyBtn = document.getElementById('compYearlyBtn');

            if (mode === 'monthly') {
                monthlyBtn.className = 'py-2 text-xs font-semibold rounded-lg bg-emerald-600 text-white shadow transition';
                yearlyBtn.className = 'py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition';
            } else {
                yearlyBtn.className = 'py-2 text-xs font-semibold rounded-lg bg-emerald-600 text-white shadow transition';
                monthlyBtn.className = 'py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition';
            }
            calculateCompoundGrowth();
        }

        // تغییر حالت نمایش نمودار
        function changeChartType(type) {
            currentChartType = type;
            const barBtn = document.getElementById('chartTypeBar');
            const lineBtn = document.getElementById('chartTypeLine');

            if (type === 'bar') {
                barBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-600 text-white transition flex items-center gap-1';
                lineBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition flex items-center gap-1';
            } else {
                lineBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-600 text-white transition flex items-center gap-1';
                barBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition flex items-center gap-1';
            }
            calculateCompoundGrowth();
        }

        // اعمال سناریوهای آماده
        function applyPreset(initial, monthly, rate, years) {
            initialInput.value = formatWithCommas(initial);
            initialSlider.value = initial;
            monthlyInput.value = formatWithCommas(monthly);
            monthlySlider.value = monthly;
            rateInput.value = rate;
            rateSlider.value = rate;
            yearsInput.value = years;
            yearsSlider.value = years;
            calculateCompoundGrowth();
        }

        function resetDefaults() {
            applyPreset(50000000, 5000000, 30, 10);
        }

        // راه‌اندازی اولیه به محض بارگذاری صفحه
        window.onload = function() {
            setupSyncListeners();
            calculateCompoundGrowth();
        };
    </script>
