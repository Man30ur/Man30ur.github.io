            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center shadow-lg shadow-emerald-600/30">
                    <i data-lucide="trending-up" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold bg-gradient-to-l from-white via-slate-100 to-emerald-400 bg-clip-text text-transparent">
                        شبیه‌ساز هوشمند سود مرکب
                    </h1>
                    <p class="text-xs text-slate-400">داشبورد تحلیل رشد سرمایه و برنامه‌ریزی مالی</p>
                </div>
            </div>

            <!-- سناریوهای آماده -->
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs text-slate-400 ml-1 hidden sm:inline">سناریوهای آماده:</span>
                <button onclick="applyPreset(50000000, 5000000, 30, 10)" class="text-xs px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition flex items-center gap-1.5">
                    <i data-lucide="shield" class="w-3.5 h-3.5 text-emerald-400"></i>
                    متعادل (۱۰ ساله)
